        { "say": "parc", "ipa": "/paʁk/", "vi": "c cuối ĐỌC (CaReFuL)" },
        { "say": "ils mangent", "ipa": "/il mɑ̃ʒ/", "vi": "'-ent' của động từ số nhiều: CÂM" }
