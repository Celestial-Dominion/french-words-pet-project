    {
      "id": "voyelles",
      "title": "Nguyên âm đơn & dấu",
      "intro": "Nguyên âm tiếng Pháp đọc gọn, không kéo dài. Dấu phụ (é, è, ê) đổi cách đọc chữ e. Chú ý: U đọc /y/ (chu môi như huýt sáo), khác hẳn tiếng Việt.",
      "items": [
        { "say": "a", "ipa": "/a/", "vi": "a — như 'a' tiếng Việt" },
        { "say": "i", "ipa": "/i/", "vi": "i" },
        { "say": "o", "ipa": "/o/", "vi": "ô" },
        { "say": "u", "ipa": "/y/", "vi": "uy — chu môi tròn, khó nhất!" },
        { "say": "é", "ipa": "/e/", "vi": "ê khép (accent aigu)" },
        { "say": "è", "ipa": "/ɛ/", "vi": "e mở (accent grave)" },
        { "say": "ê", "ipa": "/ɛ/", "vi": "e mở (accent circonflexe)" },
        { "say": "café", "ipa": "/kafe/", "vi": "ví dụ é: cà phê" },
        { "say": "père", "ipa": "/pɛʁ/", "vi": "ví dụ è: bố" }
      ]
    },
    {
      "id": "voyelles-composees",
      "title": "Nguyên âm ghép",
      "intro": "Nhiều chữ cái ghép lại thành MỘT âm. Đây là quy tắc cực quan trọng, xuất hiện khắp nơi.",
      "items": [
        { "say": "ou", "ipa": "/u/", "vi": "u — vd: nous (chúng tôi)" },
        { "say": "oi", "ipa": "/wa/", "vi": "oa — vd: moi (tôi), trois (ba)" },
        { "say": "au", "ipa": "/o/", "vi": "ô — vd: aussi (cũng)" },
        { "say": "eau", "ipa": "/o/", "vi": "ô — vd: eau (nước), beau (đẹp)" },
        { "say": "ai", "ipa": "/ɛ/", "vi": "e mở — vd: mais (nhưng)" },
        { "say": "ei", "ipa": "/ɛ/", "vi": "e mở — vd: neige (tuyết)" },
        { "say": "eu", "ipa": "/ø/", "vi": "ơ tròn môi — vd: deux (hai)" },
        { "say": "œu", "ipa": "/œ/", "vi": "ơ mở — vd: cœur (trái tim)" }
      ]
    },
    {
