      "id": "e-caduc",
      "title": "Âm 'e' và các âm /ø œ ə/",
      "intro": "Chữ e không dấu thường đọc nhẹ /ə/ (như 'ơ' rất nhẹ), đôi khi rơi hẳn khi nói nhanh.",
      "items": [
        { "say": "le", "ipa": "/lə/", "vi": "'lơ' nhẹ" },
        { "say": "je", "ipa": "/ʒə/", "vi": "'giơ' nhẹ" },
        { "say": "petit", "ipa": "/pəti/", "vi": "e giữa từ đọc nhẹ" },
        { "say": "deux", "ipa": "/dø/", "vi": "eu = /ø/ tròn môi" },
        { "say": "peur", "ipa": "/pœʁ/", "vi": "eu = /œ/ mở: nỗi sợ" },
        { "say": "samedi", "ipa": "/samdi/", "vi": "e hay rơi khi nói nhanh: thứ Bảy" }
      ]
    },
    {
      "id": "h",
      "title": "Chữ H câm & bật hơi",
      "intro": "H trong tiếng Pháp KHÔNG BAO GIỜ đọc thành tiếng. Có hai loại: H câm (cho nối âm/elision) và H bật hơi (chặn nối âm).",
      "items": [
        { "say": "l'homme", "ipa": "/lɔm/", "vi": "h câm → elision l' : người đàn ông" },
        { "say": "les hommes", "ipa": "/le zɔm/", "vi": "h câm → có liaison (z)" },
        { "say": "le héros", "ipa": "/lə eʁo/", "vi": "h bật hơi → KHÔNG elision: anh hùng" },
        { "say": "hôtel", "ipa": "/otɛl/", "vi": "h câm: khách sạn" }
      ]
    },
    {
      "id": "liaison",
      "title": "Liaison — nối âm",
      "intro": "Khi từ kết thúc bằng phụ âm câm gặp từ sau bắt đầu bằng nguyên âm (hoặc h câm), phụ âm đó 'sống dậy' và nối sang. Rất quan trọng để nghe tự nhiên.",
      "items": [
        { "say": "les amis", "ipa": "/le zami/", "vi": "s → 'z' nối: những người bạn" },
        { "say": "un enfant", "ipa": "/œ̃ nɑ̃fɑ̃/", "vi": "n nối: một đứa trẻ" },
        { "say": "vous avez", "ipa": "/vu zave/", "vi": "s → 'z' nối: các bạn có" },
        { "say": "c'est un", "ipa": "/sɛ tœ̃/", "vi": "t nối: đó là một" },
        { "say": "grand arbre", "ipa": "/ɡʁɑ̃ t‿aʁbʁ/", "vi": "d → 't' nối: cây to" }
      ]
    },
    {
      "id": "elision",
      "title": "Élision — rút gọn",
      "intro": "Trước một từ bắt đầu bằng nguyên âm (hoặc h câm), một số từ ngắn bỏ nguyên âm cuối và thay bằng dấu ' . Bắt buộc, không phải tùy chọn.",
      "items": [
        { "say": "l'école", "ipa": "/lekɔl/", "vi": "le/la + école → l' : trường học" },
        { "say": "j'ai", "ipa": "/ʒe/", "vi": "je + ai → j' : tôi có" },
        { "say": "d'accord", "ipa": "/dakɔʁ/", "vi": "de + accord → d' : đồng ý" },
        { "say": "qu'est-ce que", "ipa": "/kɛs kə/", "vi": "que + est → qu' : cái gì" },
        { "say": "n'est pas", "ipa": "/nɛ pa/", "vi": "ne + est → n' : không phải" }
      ]
    },
