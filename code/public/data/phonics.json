      "intro": "Âm MŨI là đặc trưng số một của tiếng Pháp: luồng hơi đi qua mũi, KHÔNG đọc rõ chữ n/m cuối. Có 4 âm mũi chính.",
      "items": [
        { "say": "an", "ipa": "/ɑ̃/", "vi": "ăng (mũi) — an/am/en/em" },
        { "say": "dans", "ipa": "/dɑ̃/", "vi": "ví dụ: trong" },
        { "say": "temps", "ipa": "/tɑ̃/", "vi": "ví dụ (en): thời gian" },
        { "say": "on", "ipa": "/ɔ̃/", "vi": "ông (mũi) — on/om" },
        { "say": "bon", "ipa": "/bɔ̃/", "vi": "ví dụ: tốt" },
        { "say": "in", "ipa": "/ɛ̃/", "vi": "anh (mũi) — in/im/ain/ein" },
        { "say": "pain", "ipa": "/pɛ̃/", "vi": "ví dụ (ain): bánh mì" },
        { "say": "un", "ipa": "/œ̃/", "vi": "âng (mũi) — un/um" },
        { "say": "brun", "ipa": "/bʁœ̃/", "vi": "ví dụ: nâu" }
      ]
    },
    {
      "id": "consonnes",
      "title": "Phụ âm đặc biệt",
      "intro": "Một số phụ âm đọc khác tiếng Anh/Việt, hoặc đổi âm tùy chữ đứng sau.",
      "items": [
        { "say": "ch", "ipa": "/ʃ/", "vi": "'s' như trong 'sh' — vd: chat (mèo)" },
        { "say": "gn", "ipa": "/ɲ/", "vi": "'nh' — vd: montagne (núi)" },
        { "say": "j", "ipa": "/ʒ/", "vi": "'gi' — vd: jour (ngày)" },
        { "say": "gu", "ipa": "/ɡ/", "vi": "'g' cứng (u câm) — vd: guitare" },
        { "say": "qu", "ipa": "/k/", "vi": "'c' (u câm) — vd: qui (ai)" },
        { "say": "ç", "ipa": "/s/", "vi": "c cédille = 's' — vd: français" },
        { "say": "r", "ipa": "/ʁ/", "vi": "R gằn ở cổ họng, không rung lưỡi" },
        { "say": "ill", "ipa": "/ij/", "vi": "'i-i' — vd: fille (con gái)" }
      ]
    },
    {
      "id": "c-g",
      "title": "Chữ C và G",
      "intro": "C và G đổi cách đọc tùy nguyên âm đứng SAU: trước e/i/y đọc 'mềm', trước a/o/u đọc 'cứng'.",
      "items": [
        { "say": "ca", "ipa": "/ka/", "vi": "C cứng trước a/o/u: /k/" },
        { "say": "ce", "ipa": "/sə/", "vi": "C mềm trước e/i/y: /s/" },
        { "say": "café", "ipa": "/kafe/", "vi": "ví dụ C cứng" },
        { "say": "cinéma", "ipa": "/sinema/", "vi": "ví dụ C mềm" },
        { "say": "ga", "ipa": "/ɡa/", "vi": "G cứng trước a/o/u: /ɡ/" },
        { "say": "ge", "ipa": "/ʒə/", "vi": "G mềm trước e/i/y: /ʒ/" },
        { "say": "gare", "ipa": "/ɡaʁ/", "vi": "ví dụ G cứng: nhà ga" },
        { "say": "girafe", "ipa": "/ʒiʁaf/", "vi": "ví dụ G mềm: hươu cao cổ" }
      ]
    },
    {
      "id": "muettes",
      "title": "Chữ câm cuối từ",
      "intro": "Quy tắc VÀNG: phần lớn phụ âm cuối từ KHÔNG đọc (nhất là e, s, t, d, x, p). Nhớ mẹo 'CaReFuL' (c, r, f, l thường ĐỌC).",
