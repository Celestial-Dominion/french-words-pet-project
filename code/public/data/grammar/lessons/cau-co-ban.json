{"id":"cau-co-ban","lv":"a1","n":1,"cat":"pronouns","t":"Đại từ chủ ngữ & câu cơ bản","en":"je · tu · il · elle · nous · vous","sum":"Câu tiếng Pháp xếp như tiếng Việt: chủ ngữ + động từ + bổ ngữ. Chủ ngữ thường là một trong tám đại từ je, tu, il, elle, on, nous, vous, ils, elles. Với người lạ hay người lớn tuổi, nói vous thay cho tu.","forms":[{"f":"je · tu · il / elle / on","vi":"tôi · bạn · anh ấy / cô ấy / người ta"},{"f":"nous · vous · ils / elles","vi":"chúng tôi · các bạn, ông bà · họ"},{"f":"chủ ngữ + động từ + bổ ngữ","vi":"Je parle français."}],"pts":[{"id":"subject-pronouns","name":"Pronoms sujets","vi":"Đại từ chủ ngữ: je, tu, il, elle, on, nous, vous, ils, elles"},{"id":"tu-vous","name":"Tu ou vous","vi":"tu thân mật · vous lịch sự hoặc số nhiều"},{"id":"svo-order","name":"Ordre sujet-verbe-complément","vi":"Trật tự câu: chủ ngữ + động từ + bổ ngữ"}],"cast":{"lea":{"name":{"en":"Léa","vi":"Léa"},"look":"woman","style":{"outfit":"blouse","top":"#D9774F","topShade":"#BF6340","accent":"#C8603B","hair":"long","hairColor":"#6B4226"},"x":560},"nam":{"name":{"en":"Nam","vi":"Nam"},"look":"man","style":{"outfit":"shirt","top":"#4F7CC4","topShade":"#3F68A8","accent":"#3F68A8","hair":"fringe","hairColor":"#1F1B1A","skin":"#EFC9A4","skinShade":"#DDB08A"},"x":1040}},"bg":"campus-gate","beats":[{"k":"e","sec":"hook","en":"Salut ! Je suis Léa.","vi":"Chào cậu! Mình là Léa.","ipa":["saly","ʒə","sɥi",""],"who":"lea","ann":{"expression":"happy","gesture":"wave"},"b":1,"start":0.476,"end":2.206,"timing":[[0,0.476],[1,1.315],[2,1.585],[3,1.798]]},{"k":"e","sec":"hook","en":"Bonjour, Léa ! Je suis Nam.","vi":"Chào Léa! Mình là Nam.","ipa":["bɔ̃ʒuʁ","","ʒə","sɥi",""],"who":"nam","ann":{"expression":"happy"},"b":1,"start":2.996,"end":6.106,"timing":[[0,2.996],[1,3.792],[2,5.177],[3,5.461],[4,5.645]]},{"k":"n","sec":"hook","parts":[{"v":"Cả hai câu đều mở đầu bằng "},{"e":"je"},{"v":", nghĩa là “tôi”. Hầu như câu tiếng Pháp nào cũng bắt đầu bằng một chủ ngữ như thế."}],"b":1,"start":6.746,"end":14.466},{"k":"n","sec":"meaning","parts":[{"v":"Tin vui: câu tiếng Pháp xếp giống tiếng Việt. Ai, làm gì, rồi tới cái gì."}],"b":2,"start":15.456,"end":21.026},{"k":"e","sec":"meaning","en":"Je parle français.","vi":"Tôi nói tiếng Pháp.","ipa":["ʒə","paʁl","fʁɑ̃sɛ"],"hl":[[0,2,"s"],[3,8,"v"],[9,17,"o"]],"b":3,"start":21.566,"end":22.696,"timing":[[0,21.566],[1,21.72],[2,22.058]]},{"k":"n","sec":"meaning","parts":[{"v":"Chủ ngữ "},{"e":"je"},{"v":", động từ "},{"e":"parle"},{"v":", rồi bổ ngữ "},{"e":"français"},{"v":". Thứ tự y như “tôi nói tiếng Pháp”."}],"b":3,"start":23.336,"end":29.776,"cues":[[0,24.036],[1,25.286],[2,27.046]]},{"k":"e","sec":"meaning","en":"Nous habitons à Lyon.","vi":"Chúng tôi sống ở Lyon.","ipa":["nu","abitɔ̃","a",""],"hl":[[0,4,"s"],[5,13,"v"],[14,20,"t"]],"b":4,"start":30.316,"end":31.536,"timing":[[0,30.316],[1,30.45],[2,31.052],[3,31.185]]},{"k":"n","sec":"form","parts":[{"v":"Có tám đại từ cần thuộc. Ngôi thứ nhất là "},{"e":"je"},{"v":" và "},{"e":"nous"},{"v":". Ngôi thứ hai là "},{"e":"tu"},{"v":" và "},{"e":"vous"},{"v":"."}],"b":5,"start":32.526,"end":40.206},{"k":"n","sec":"form","parts":[{"v":"Ngôi thứ ba số ít có "},{"e":"il"},{"v":" cho nam, "},{"e":"elle"},{"v":" cho nữ, và "},{"e":"on"},{"v":", nghĩa là người ta hoặc chúng mình."}],"b":5,"start":40.846,"end":47.626},{"k":"n","sec":"form","parts":[{"v":"Số nhiều có "},{"e":"ils"},{"v":" cho nhóm có ít nhất một nam, và "},{"e":"elles"},{"v":" khi cả nhóm đều là nữ."}],"b":5,"start":48.266,"end":54.056},{"k":"e","sec":"examples","en":"Il est grand.","vi":"Anh ấy cao.","ipa":["il","e","ɡʁɑ̃"],"hl":[[0,2,"s"]],"b":6,"start":54.946,"end":55.536,"timing":[[0,54.946],[1,55.045],[2,55.134]]},{"k":"e","sec":"examples","en":"Elles sont sœurs.","vi":"Họ là chị em.","ipa":["ɛl","sɔ̃","sœʁ"],"hl":[[0,5,"s"]],"note":"cả nhóm là nữ → elles","b":7,"start":56.176,"end":57.056,"timing":[[0,56.176],[1,56.285],[2,56.506]]},{"k":"e","sec":"examples","en":"Paul et Marie ? Ils sont au café.","vi":"Paul và Marie hả? Họ ở quán cà phê.","ipa":["","e","maʁi","il","sɔ̃","o","kafe"],"hl":[[16,19,"s"]],"note":"có một nam → ils","b":8,"start":57.696,"end":60.626,"timing":[[0,57.696],[1,57.874],[2,57.932],[3,59.485],[4,59.721],[5,59.912],[6,60.088]]},{"k":"e","sec":"examples","en":"Le livre ? Il est sur la table.","vi":"Quyển sách à? Nó ở trên bàn.","ipa":["lə","livʁ","il","e","syʁ","la","tabl"],"hl":[[11,13,"s"]],"note":"đồ vật cũng là il / elle","b":9,"start":61.266,"end":64.266,"timing":[[0,61.266],[1,61.424],[2,63.007],[3,63.257],[4,63.345],[5,63.565],[6,63.727]]},{"k":"n","sec":"examples","parts":[{"v":"Đồ vật cũng dùng "},{"e":"il"},{"v":" hay "},{"e":"elle"},{"v":", tùy giống của danh từ. "},{"e":"Le livre"},{"v":" là giống đực, nên gọi là "},{"e":"il"},{"v":"."}],"b":9,"start":64.906,"end":72.246,"cues":[[0,66.056],[0,71.966]]},{"k":"e","sec":"examples","en":"On va au café ?","vi":"Mình đi cà phê nhé?","ipa":["ɔ̃","va","o","kafe"],"hl":[[0,2,"s"]],"note":"on = chúng mình (khi nói)","b":10,"start":72.786,"end":73.766,"timing":[[0,72.786],[1,72.866],[2,73.087],[3,73.204]]},{"k":"n","sec":"examples","parts":[{"v":"Khi nói chuyện, người Pháp rất hay dùng "},{"e":"on"},{"v":" thay cho "},{"e":"nous"},{"v":". "},{"e":"On"},{"v":" chia động từ giống như "},{"e":"il"},{"v":"."}],"b":10,"start":74.406,"end":80.496,"cues":[[0,76.796],[0,78.446]]},{"k":"e","sec":"contrast","en":"Tu es malade ?","vi":"Cậu ốm à?","ipa":["ty","ɛ","malad"],"b":11,"start":81.386,"end":82.236,"timing":[[0,81.386],[1,81.5],[2,81.588]]},{"k":"e","sec":"contrast","en":"Vous êtes malade ?","vi":"Ông ốm à?","ipa":["vu","ɛt","malad"],"b":11,"start":82.876,"end":83.936,"timing":[[0,82.876],[1,82.965],[2,83.289]]},{"k":"n","sec":"contrast","parts":[{"e":"Tu"},{"v":" dùng với bạn bè, người trong nhà và trẻ em. "},{"e":"Vous"},{"v":" dùng với người lạ, thầy cô, khách hàng, và khi nói với nhiều người."}],"b":11,"start":84.576,"end":93.216,"cues":[[0,84.576],[1,88.316]]},{"k":"n","sec":"contrast","parts":[{"v":"Không chắc thì cứ dùng "},{"e":"vous"},{"v":". Lịch sự thì không bao giờ sai."}],"b":11,"start":93.856,"end":97.466,"cues":[[1,95.216]]},{"k":"n","sec":"pronunciation","parts":[{"v":"Trước nguyên âm hoặc chữ h câm, "},{"e":"je"},{"v":" mất chữ e, thành "},{"e":"j'aime"},{"v":", "},{"e":"j'habite"},{"v":"."}],"b":12,"start":98.456,"end":103.886,"cues":[[0,102.386],[1,103.126]]},{"k":"n","sec":"pronunciation","parts":[{"v":"Còn "},{"e":"ils ont"},{"v":" đọc nối, chữ s cuối biến thành âm z. Đừng nhầm với "},{"e":"ils sont"},{"v":": một bên là “họ có”, một bên là “họ là”."}],"b":12,"start":104.526,"end":112.736,"cues":[[2,104.996],[3,109.086]]},{"k":"e","sec":"pronunciation","en":"Ils ont un chien.","vi":"Họ có một con chó.","ipa":["il","ɔ̃","œ̃","ʃjɛ̃"],"b":12,"start":113.276,"end":114.186,"timing":[[0,113.276],[1,113.405],[2,113.611],[3,113.728]]},{"k":"n","sec":"mistakes","parts":[{"v":"Trước nguyên âm, "},{"e":"je"},{"v":" phải bỏ chữ e và viết liền: "},{"e":"j'ai"},{"v":"."}],"b":13,"start":115.176,"end":119.126},{"k":"e","sec":"mistakes","en":"J'ai un chat.","vi":"Tôi có một con mèo.","ipa":["ʒɛ","œ̃","ʃa"],"bad":{"en":"Je ai un chat."},"b":13,"start":119.666,"end":120.446,"timing":[[0,119.666],[1,119.917],[2,120.079]]},{"k":"n","sec":"mistakes","parts":[{"v":"Chỉ cần một nam trong nhóm là dùng "},{"e":"ils"},{"v":". "},{"e":"Elles"},{"v":" chỉ dành cho nhóm toàn nữ."}],"b":14,"start":121.086,"end":125.566},{"k":"e","sec":"mistakes","en":"Marie et Paul ? Ils sont ici.","vi":"Marie và Paul à? Họ ở đây.","ipa":["maʁi","e","","il","sɔ̃","isi"],"bad":{"en":"Marie et Paul ? Elles sont ici."},"b":14,"start":126.106,"end":129.236,"timing":[[0,126.106],[1,126.529],[2,126.647],[3,128.2],[4,128.45],[5,128.641]]},{"k":"n","sec":"mistakes","parts":[{"v":"Với người lạ, người lớn tuổi, phải dùng "},{"e":"vous"},{"v":". Nói "},{"e":"tu"},{"v":" nghe rất suồng sã."}],"b":15,"start":129.876,"end":135.426},{"k":"e","sec":"mistakes","en":"Bonjour madame, vo