{"id":"phu-dinh","lv":"a1","n":7,"cat":"negation","t":"Phủ định: ne… pas","en":"Je ne parle pas · pas de café","sum":"Câu phủ định kẹp động từ giữa ne và pas: je ne parle pas. Trước nguyên âm, ne thành n'. Sau phủ định, un, une, des đổi thành de: je n'ai pas de voiture. Khi nói chuyện, người Pháp hay bỏ ne.","forms":[{"f":"ne + động từ + pas","vi":"Je ne parle pas."},{"f":"n' + nguyên âm","vi":"Je n'aime pas."},{"f":"pas de thay un / une / des","vi":"Je n'ai pas de chat."}],"pts":[{"id":"ne-pas","name":"ne… pas","vi":"Phủ định ne… pas (n' trước nguyên âm)"},{"id":"pas-de","name":"pas de / pas d'","vi":"Sau phủ định: un, une, des, du → de"}],"cast":{"maman":{"name":{"en":"Maman","vi":"Mẹ"},"look":"mom","x":560},"tom":{"name":{"en":"Tom","vi":"Tom"},"look":"boy","style":{"top":"#5DBB63","topShade":"#4AA350","collar":"#4AA350","accent":"#3E9A45","hairColor":"#C98A3C"},"x":1040}},"bg":"home-day","beats":[{"k":"e","sec":"hook","en":"Tom, tu manges ta soupe ?","vi":"Tom, con ăn súp chứ?","ipa":["tɔm","ty","mɑ̃ʒ","ta","sup"],"who":"maman","ann":{"expression":"happy"},"b":1,"start":0.476,"end":2.006,"timing":[[0,0.476],[1,1.059],[2,1.172],[3,1.485],[4,1.684]]},{"k":"e","sec":"hook","en":"Non, je ne mange pas la soupe !","vi":"Không, con không ăn súp đâu!","ipa":["nɔ̃","ʒə","nə","mɑ̃ʒ","pa","la","sup"],"who":"tom","ann":{"expression":"angry","gesture":"shake"},"b":1,"start":2.796,"end":4.736,"timing":[[0,2.796],[1,3.345],[2,3.529],[3,3.671],[4,3.941],[5,4.112],[6,4.254]]},{"k":"n","sec":"hook","parts":[{"v":"Tom nói không bằng hai chữ: "},{"e":"ne"},{"v":" đứng trước động từ, "},{"e":"pas"},{"v":" đứng sau. Động từ bị kẹp ở giữa."}],"b":1,"start":5.376,"end":12.396},{"k":"n","sec":"meaning","parts":[{"v":"Tiếng Việt chỉ cần một chữ “không”. Tiếng Pháp cần hai: "},{"e":"ne"},{"v":" và "},{"e":"pas"},{"v":"."}],"b":2,"start":13.386,"end":18.796},{"k":"e","sec":"meaning","en":"Je parle français.","vi":"Tôi nói tiếng Pháp.","ipa":["ʒə","paʁl","fʁɑ̃sɛ"],"b":3,"start":19.336,"end"