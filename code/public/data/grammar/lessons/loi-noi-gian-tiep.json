 không.","ipa":["mɔ̃","vwazɛ̃","dəmɑ̃d","si","ɔ̃","pø","bese","la","myzik"],"hl":[[19,21,"k"]],"b":5,"start":35.376,"end":37.866,"timing":[[0,35.376],[1,35.515],[2,35.923],[3,36.409],[4,36.646],[5,36.725],[6,36.883],[7,37.199],[8,37.317]]},{"k":"e","sec":"examples","en":"Le client demande combien coûte ce manteau.","vi":"Khách hỏi chiếc áo khoác này giá bao nhiêu.","ipa":["lə","klijɑ̃","dəmɑ̃d","kɔ̃bjɛ̃","kut","sø","mɑ̃to"],"hl":[[18,25,"k"]],"b":6,"start":38.506,"end":40.716,"timing":[[0,38.506],[1,38.599],[2,39.007],[3,39.428],[4,39.797],[5,40.073],[6,40.244]]},{"k":"e","sec":"examples","en":"Je ne sais pas ce que tu veux dire.","vi":"Tôi không biết bạn muốn nói gì.","ipa":["ʒə","nə","sɛ","pa","sø","kə","ty","vø","diʁ"],"hl":[[15,21,"k"]],"b":7,"start":41.356,"end":42.996,"timing":[[0,41.356],[1,41.475],[2,41.62],[3,41.791],[4,41.949],[5,42.094],[6,42.239],[7,42.397],[8,42.554]]},{"k":"e","sec":"examples","en":"Le médecin me dit de rester au lit.","vi":"Bác sĩ bảo tôi nằm nghỉ trên giường.","ipa":["lə","mɛdsɛ̃","mə","di","də","ʁɛste","o","li"],"hl":[[18,20,"k"]],"b":8,"start":43.636,"end":45.426,"timing":[[0,43.636],[1,43.732],[2,44.167],[3,44.311],[4,44.469],[5,44.601],[6,44.995],[7,45.088]]},{"k":"n","sec":"pronunciation","parts":[{"e":"Si"},{"v":" chỉ rút gọn trước "},{"e":"il"},{"v":" và "},{"e":"ils"},{"v":". Trước "},{"e":"elle"},{"v":", giữ nguyên "},{"e":"si elle"},{"v":"."}],"b":9,"start":46.416,"end":51.686,"cues":[[1,51.166]]},{"k":"e","sec":"pronunciation","en":"Il demande s'il peut entrer.","vi":"Anh ấy hỏi anh ấy có thể vào không.","ipa":["il","dəmɑ̃d","sil","pø","ɑ̃tʁe"],"b":9,"start":52.226,"end":53.686,"timing":[[0,52.226],[1,52.329],[2,52.763],[3,53.027],[4,53.171]]},{"k":"n","sec":"mistakes","parts":[{"v":"Câu hỏi có hoặc không thì dùng "},{"e":"si"},{"v":"."}],"b":10,"start":54.676,"end":56.856},{"k":"e","sec":"mistakes","en":"Il demande si tu viens.","vi":"Anh ấy hỏi bạn có đến không.","ipa":["il","dəmɑ̃d","si","ty","vjɛ̃"],"bad":{"en":"Il demande que tu viens."},"b":10,"start":57.396,"end":58.616,"timing":[[0,57.396],[1,57.502],[2,57.937],[3,58.147],[4,58.292]]},{"k":"n","sec":"mistakes","parts":[{"e":"Qu'est-ce que"},{"v":" đổi thành "},{"e":"ce que"},{"v":"."}],"b":11,"start":59.256,"end":61.296},{"k":"e","sec":"mistakes","en":"Elle demande ce que tu fais.","vi":"Cô ấy hỏi bạn đang làm gì.","ipa":["ɛl","dəmɑ̃d","sø","kə","ty","fɛ"],"bad":{"en":"Elle demande qu'est-ce que tu fais."},"b":11,"start":61.836,"end":63.236,"timing":[[0,61.836],[1,61.988],[2,62.448],[3,62.619],[4,62.764],[5,62.922]]},{"k":"n","sec":"mistakes","parts":[{"v":"Câu hỏi gián tiếp không đảo ngữ."}],"b":12,"start":63.876,"end":65.536},{"k":"e","sec":"mistakes","en":"Il demande où tu habites.","vi":"Anh ấy hỏi bạn sống ở đâu.","ipa":["il","dəmɑ̃d","u","ty","abit"],"bad":{"en":"Il demande où habites-tu."},"b":12,"start":66.076,"end":67.436,"timing":[[0,66.076],[1,66.182],[2,66.617],[3,66.695],[4,66.88]]},{"k":"n","sec":"mistakes","parts":[{"v":"Mệnh lệnh thì dùng "},{"e":"de"},{"v":" cộng nguyên mẫu."}],"b":13,"start":68.076,"end":70.586},{"k":"e","sec":"mistakes","en":"Il me dit de venir.","vi":"Anh ấy bảo tôi đến.","ipa":["il","mə","di","də","vəniʁ"],"bad":{"en":"Il me dit venir."},"b":13,"start":71.126,"end":72.246,"timing":[[0,71.126],[1,71.229],[2,71.374],[3,71.532],[4,71.663]]},{"k":"e","sec":"dialogue","en":"Et il dit pourquoi la réunion est annulée ?","vi":"Thế ông ấy có nói vì sao cuộc họp bị huỷ không?","ipa":["e","il","di","puʁkwa","la","ʁeynjɔ̃","e","anyle"],"who":"lea","ann":{"expression":"surprised"},"b":14,"start":73.386,"end":75.106,"timing":[[0,73.386],[1,73.388],[2,73.518],[3,73.636],[4,73.987],[5,74.091],[6,74.534],[7,74.599]]},{"k":"e","sec":"dialogue","en":"Il explique qu'un client important arrive ce matin.","vi":"Ông ấy giải thích là sáng nay có một khách hàng quan trọng đến.","ipa":["il","ɛksplik","kœ̃","klijɑ̃","ɛ̃pɔʁtɑ̃","aʁiv","sø","matɛ̃"],"who":"karim","ann":{"gesture":"explain"},"b":14,"start":75.896,"end