"end":61.976,"timing":[[0,59.526],[1,59.709],[2,60.159],[3,60.259],[4,61.084],[5,61.184],[6,61.346]]},{"k":"n","sec":"mistakes","parts":[{"v":"Phân từ hợp với danh từ đi kèm: "},{"e":"les valises faites"},{"v":"."}],"b":11,"start":62.616,"end":65.926},{"k":"e","sec":"mistakes","en":"Une fois les valises faites, nous sommes partis.","vi":"Xếp vali xong, chúng tôi lên đường.","ipa":["yn","fwa","le","valiz","fɛt","nu","sɔm","paʁti"],"bad":{"en":"Une fois les valises fait, nous sommes partis."},"b":11,"start":66.466,"end":68.846,"timing":[[0,66.466],[1,66.568],[2,66.781],[3,66.893],[4,67.268],[5,67.931],[6,68.068],[7,68.318]]},{"k":"e","sec":"dialogue","en":"Et ce matin, ça s'est passé comment ?","vi":"Thế sáng nay thì sao?","ipa":["e","sø","matɛ̃","sa","se","pase","komɑ̃"],"who":"ines","ann":{"expression":"thinking"},"b":12,"start":69.986,"end":71.606,"timing":[[0,69.986],[1,70.042],[2,70.176],[3,70.698],[4,70.855],[5,70.977],[6,71.256]]},{"k":"e","sec":"dialogue","en":"Réveillé à cinq heures, j'ai couru au guichet. Une fois le nouveau billet acheté, j'ai enfin pu manger.","vi":"Thức dậy lúc năm giờ, anh chạy ra quầy vé. Mua được vé mới xong, anh mới ăn được.","ipa":["ʁeveje","a","sɛ̃k","œʁ","ʒɛ","kuʁy","o","ɡiʃɛ","yn","fwa","lə","nuvo","bijɛ","aʃəte","ʒɛ","ɑ̃fɛ̃","py","mɑ̃ʒe"],"who":"hugo","ann":{"gesture":"explain"},"b":12,"start":72.396,"end":77.996,"timing":[[0,72.396],[1,72.796],[2,72.871],[3,73.171],[4,73.896],[5,74.021],[6,74.308],[7,74.371],[8,75.271],[9,75.421],[10,75.633],[11,75.721],[12,75.983],[13,76.221],[14,77.096],[15,77.221],[16,77.458],[17,77.583]]},{"k":"e","sec":"dialogue","en":"Et ta valise ?","vi":"Còn vali của anh?","ipa":["e","ta","valiz"],"who":"ines","ann":{"expression":"worried"},"b":12,"start":78.786,"end":79.466,"timing":[[0,78.786],[1,78.818],[2,78.952]]},{"k":"e","sec":"dialogue","en":"Partie sans moi ! Elle arrivera demain, paraît-il.","vi":"Bay đi mà không có anh! Nghe nói mai nó mới tới.","ipa":["paʁti","sɑ̃","mwa","ɛl","aʁivəʁa","dəmɛ̃","paʁɛil"],"who":"hugo","ann":{"expression":"surprised"},"b":12,"start":80.256,"end":83.516,"timing":[[0,80.256],[1,80.526],[2,80.738],[3,81.501],[4,81.639],[5,82.026],[6,82.876]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Pháp: Mệt, anh ấy đi ngủ sớm."}],"b":13,"hold":1,"start":84.506,"end":87.456},{"k":"e","sec":"recall","en":"Fatigué, il s'est couché tôt.","vi":"Mệt, anh ấy đi ngủ sớm.","ipa":["fatiɡe","il","se","kuʃe","to"],"b":14,"start":87.996,"end":89.766,"timing":[[0,87.996],[1,88.851],[2,88.976],[3,89.126],[4,89.501]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Pháp: Mua vé xong, chúng tôi tìm khách sạn."}],"b":15,"hold":1,"start":90.406,"end":93.826},{"k":"e","sec":"recall","en":"Une fois les billets achetés, on a cherché un hôtel.","vi":"Mua vé xong, chúng tôi tìm khách sạn.","ipa":["yn","fwa","le","bijɛ","aʃəte","ɔ̃","a","ʃɛʁʃe","œ̃","otɛl"],"b":16,"start":94.366,"end":97.136,"timing":[[0,94.366],[1,94.481],[2,94.693],[3,94.818],[4,95.081],[5,95.869],[6,95.919],[7,96.056],[8,96.456],[9,96.556]]},{"k":"n","sec":"recap","parts":[{"v":"Cụm phân từ đầu câu: phân từ đứng một mình, "},{"e":"ayant"},{"v":" hoặc "},{"e":"étant"},{"v":" với phân từ, "},{"e":"une fois"},{"v":" với phân từ. Chủ ngữ ngầm phải là chủ ngữ của câu chính."}],"b":17,"start":98.126,"end":108.156}],"boards":[{"type":"title"},{"type":"scene"},{"type":"pair","beats":[3,4],"labels":["mệnh đề đầy đủ","cụm phân từ: gọn hơn"]},{"type":"table","head":["Dạng","Ví dụ"],"rows":[["phân từ đứng một mình","Arrivée à Paris, elle a appelé sa mère."],["với ayant","Ayant fini son travail, il est sorti."],["với étant","Étant arrivés tôt, nous avons pris un café."],["với une fois","Une fois la porte fermée, on peut parler."]]},{"type":"line","beat":7},{"type":"line","beat":8},{"type":"line","beat":9},{"type":"line","beat":10},{"type":"line","beat":11},{"type":"fix","beat":13},{"type":"fix","beat":15},{"type":"fix","beat":17},{"type":"scene"},{"type":"quiz","q":"Nói bằng tiếng Pháp: Mệt, anh ấy đi ngủ sớm.","beat":23},{"type":"line","beat":23},{"type":"quiz","q":"Nói bằng tiếng Pháp: Mua vé xong, chúng tôi tìm khách sạn.","beat":25},{"type":"line","beat":25},{"type":"recap"}],"ex":[{"k":"fill","stem":"Elle a appelé sa mère, une fois ___ à Paris.","o":["arrivée","arrivé","arrivant"],"a":0,"why":"hợp với elle."},{"k":"fill","stem":"Une fois les valises ___ , nous sommes partis.","o":["faites","fait","faits"],"a":0,"why":"hợp với les valises."},{"k":"fill","stem":"Il a appelé un voisin, ___ perdu ses clés.","o":["ayant","étant","avant"],"a":0,"why":"perdre → avoir."},{"k":"fill","stem":"Le repas ___ , tout le monde est allé se promener.","o":["terminé","terminant","terminer"],"a":0,"why":"phân từ quá khứ."},{"k":"contrast","stem":"Étant ___ en retard, elle s'est excusée.","o":["arrivée","arrivé"],"a":0,"why":"hợp với elle."},{"k":"type","stem":"Une fois les billets ___ (acheter), on a cherché un hôtel.","ans":["achetés"],"why":"hợp với les billets."},{"k":"fix","stem":"Arrivé à la gare, le train était déjà parti.","o":["Arrivé à la gare, j'ai vu que le train était déjà parti.","Arrivé à la gare, le train est déjà parti.","Arrivant la gare, le train était parti."],"a":0,"why":"chủ ngữ phải trùng."},{"k":"listen","beat":4,"o":["Ayant raté l'avion, j'ai dormi à l'hôtel.","Ayant raté l'avion, j'ai dormi à l'aéroport.","J'ai raté l'avion, j'ai dormi à l'hôtel."],"a":0,"en":1,"why":"ayant raté."},{"k":"natural","o":["Arrivé à la gare, j'ai vu que le train était déjà parti.","Arrivé à la gare, le train était déjà parti."],"a":0}],"words":[{"id":"valise","ipa":"valiz","vi":"va li","level":1},{"id":"avion","ipa":"avjɔ̃","vi":"máy bay","level":0},{"id":"billet","ipa":"bijɛ","vi":"vé; tờ tiền","level":1},{"id":"guichet","ipa":"ɡiʃɛ","vi":"quầy giao dịch, cửa bán vé","level":3}],"audio":{"src":"/audio/grammar/menh-de-phan-tu.mp3","v":"cb8b885185","duration":109.032,"fps":25,"mouth":""}}