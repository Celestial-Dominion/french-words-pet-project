ưng có ba dạng."}],"b":1,"start":8.716,"end":14.076},{"k":"n","sec":"meaning","parts":[{"v":"Bạn đã biết luật chung: thêm "},{"e":"e"},{"v":" cho giống cái. Nhưng nhiều tính từ thay đổi nhiều hơn thế ở phần đuôi."}],"b":2,"start":15.066,"end":21.676},{"k":"e","sec":"meaning","en":"un garçon heureux → une fille heureuse","vi":"một cậu bé hạnh phúc → một cô bé hạnh phúc","ipa":["œ̃","ɡaʁsɔ̃","øʁø","yn","fij","øʁøz"],"hl":[[10,17,"k"],[30,38,"k"]],"note":"-eux → -euse","b":3,"start":22.216,"end":24.066,"timing":[[0,22.216],[1,22.286],[2,22.786],[3,23.092],[4,23.244],[5,23.536]]},{"k":"e","sec":"meaning","en":"un homme sportif → une femme sportive","vi":"một người đàn ông thể thao → một phụ nữ thể thao","ipa":["œ̃","ɔm","spɔʁtif","yn","fam","spɔʁtiv"],"hl":[[9,16,"k"],[29,37,"k"]],"note":"-if → -ive","b":4,"start":24.706,"end":26.776,"timing":[[0,24.706],[1,24.75],[2,25.028],[3,25.597],[4,25.736],[5,26.014]]},{"k":"n","sec":"form","parts":[{"v":"Học theo nhóm đuôi sẽ nhớ nhanh hơn từng từ một."}],"b":5,"start":27.766,"end":30.256},{"k":"e","sec":"examples","en":"Ma grand-mère est très gentille.","vi":"Bà tôi rất hiền.","ipa":["ma","ɡʁɑ̃mɛʁ","e","tʁɛ","ʒɑ̃tij"],"hl":[[23,31,"k"]],"b":6,"start":31.146,"end":32.726,"timing":[[0,31.146],[1,31.254],[2,31.809],[3,31.865],[4,32.087]]},{"k":"e","sec":"examples","en":"Cette robe est trop chère.","vi":"Chiếc váy này đắt quá.","ipa":["sɛt","ʁɔb","e","tʁo","ʃɛʁ"],"hl":[[20,25,"k"]],"b":7,"start":33.366,"end":34.686,"timing":[[0,33.366],[1,33.605],[2,33.869],[3,33.938],[4,34.16]]},{"k":"e","sec":"examples","en":"J'ai une bonne nouvelle !","vi":"Tôi có một tin vui!","ipa":["ʒɛ","yn","bɔn","nuvɛl"],"hl":[[9,14,"k"]],"b":8,"start":35.326,"end":36.486,"timing":[[0,35.326],[1,35.507],[2,35.646],[3,35.868]]},{"k":"e","sec":"examples","en":"Elle est sportive et courageuse.","vi":"Cô ấy giỏi thể thao và dũng cảm.","ipa":["ɛl","e","spɔʁtiv","e","kuʁaʒøz"],"hl":[[9,17,"k"],[21,31,"k"]],"b":9,"start":37.126,"end":38.806,"timing":[[0,37.126],[1