"],"hl":[[11,17,"k"]],"b":5,"start":41.986,"end":45.356,"timing":[[0,41.986],[1,42.098],[2,42.561],[3,42.836],[4,43.311],[5,43.386],[6,43.586],[7,44.361],[8,44.498],[9,44.661],[10,44.723],[11,44.936]]},{"k":"e","sec":"examples","en":"Tu aurais dû m'écouter !","vi":"Lẽ ra bạn nên nghe tôi!","ipa":["ty","oʁɛ","dy","mekute"],"hl":[[3,12,"k"]],"b":6,"start":45.996,"end":46.996,"timing":[[0,45.996],[1,46.096],[2,46.309],[3,46.434]]},{"k":"e","sec":"examples","en":"Ouf ! Tu aurais pu tomber !","vi":"Phù! Suýt nữa thì bạn ngã!","ipa":["uf","ty","oʁɛ","py","tɔ̃be"],"hl":[[9,18,"k"]],"b":7,"start":47.636,"end":49.876,"timing":[[0,47.636],[1,48.884],[2,49.071],[3,49.284],[4,49.434]]},{"k":"e","sec":"examples","en":"J'ai enfin pu lui parler.","vi":"Cuối cùng tôi cũng nói chuyện được với anh ấy.","ipa":["ʒɛ","ɑ̃fɛ̃","py","lɥi","paʁle"],"hl":[[11,13,"k"]],"b":8,"start":50.516,"end":51.766,"timing":[[0,50.516],[1,50.694],[2,51.043],[3,51.218],[4,51.356]]},{"k":"n","sec":"mistakes","parts":[{"v":"Việc đã qua: "},{"e":"conditionnel passé"},{"v":" "},{"e":"aurais dû"},{"v":"."}],"b":9,"start":52.756,"end":55.786},{"k":"e","sec":"mistakes","en":"Tu aurais dû m'écouter hier.","vi":"Hôm qua lẽ ra bạn nên nghe tôi.","ipa":["ty","oʁɛ","dy","mekute","jɛʁ"],"bad":{"en":"Tu devrais m'écouter hier."},"b":9,"start":56.326,"end":57.716,"timing":[[0,56.326],[1,56.413],[2,56.651],[3,56.776],[4,57.226]]},{"k":"n","sec":"mistakes","parts":[{"v":"Phỏng đoán việc đã xảy ra: "},{"e":"a dû"},{"v":"."}],"b":10,"start":58.356,"end":60.566},{"k":"e","sec":"mistakes","en":"Il n'est pas là, il a dû partir.","vi":"Anh ấy không có ở đây, chắc là đã đi rồi.","ipa":["il","ne","pa","la","il","a","dy","paʁtiʁ"],"bad":{"en":"Il n'est pas là, il doit partir."},"b":10,"start":61.106,"end":62.896,"timing":[[0,61.106],[1,61.196],[2,61.334],[3,61.496],[4,61.996],[5,62.096],[6,62.171],[7,62.296]]},{"k":"n","sec":"mistakes","parts":[{"v":"Sau "},{"e":"aurait pu"},{"v":" là nguyên mẫu thường."}],"b":11,"start":63.536,"en