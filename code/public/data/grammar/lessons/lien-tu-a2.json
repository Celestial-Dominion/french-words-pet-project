,8.505],[14,8.641]]},{"k":"n","sec":"hook","parts":[{"e":"D'abord"},{"v":", "},{"e":"ensuite"},{"v":", "},{"e":"enfin"},{"v":": những từ nối nhỏ này giúp câu chuyện có thứ tự rõ ràng."}],"b":1,"start":9.776,"end":15.126},{"k":"n","sec":"meaning","parts":[{"v":"Học theo nhóm chức năng: thời gian, lý do, kết quả, đối lập, thứ tự."}],"b":2,"start":16.116,"end":21.136},{"k":"n","sec":"form","parts":[{"e":"Comme"},{"v":" và "},{"e":"parce que"},{"v":" đều là “vì”. Nhưng "},{"e":"comme"},{"v":" luôn đứng đầu câu, còn "},{"e":"parce que"},{"v":" thường đứng giữa."}],"b":3,"start":22.126,"end":30.776},{"k":"e","sec":"form","en":"Comme il pleut, je reste à la maison.","vi":"Vì trời mưa nên tôi ở nhà.","ipa":["kɔm","il","plø","ʒə","ʁɛst","a","la","mɛzɔ̃"],"b":4,"start":31.316,"end":33.496,"timing":[[0,31.316],[1,31.462],[2,31.614],[3,32.337],[4,32.489],[5,32.837],[6,32.892],[7,33.031]]},{"k":"e","sec":"form","en":"Je reste à la maison parce qu'il pleut.","vi":"Tôi ở nhà vì trời mưa.","ipa":["ʒə","ʁɛst","a","la","mɛzɔ̃","paʁs","kil","plø"],"b":4,"start":34.136,"end":36.106,"timing":[[0,34.136],[1,34.317],[2,34.678],[3,34.734],[4,34.873],[5,35.262],[6,35.539],[7,35.762]]},{"k":"n","sec":"form","parts":[{"e":"Pourtant"},{"v":" mạnh hơn "},{"e":"mais"},{"v":": nó nhấn mạnh điều bất ngờ, trái với mong đợi."}],"b":4,"start":36.746,"end":41.376},{"k":"e","sec":"examples","en":"Quand j'étais petit, j'habitais à Lyon.","vi":"Khi còn nhỏ, tôi sống ở Lyon.","ipa":["kɑ̃","ʒetɛ","pəti","ʒabitɛ","a",""],"hl":[[0,5,"c"]],"b":5,"start":42.266,"end":44.476,"timing":[[0,42.266],[1,42.356],[2,42.717],[3,43.523],[4,44.037],[5,44.134]]},{"k":"e","sec":"examples","en":"Comme c'est ton anniversaire, je t'invite.","vi":"Vì hôm nay sinh nhật cậu nên mình mời.","ipa":["kɔm","se","tɔ̃","anivɛʁsɛʁ","ʒə","tɛ̃vit"],"hl":[[0,5,"c"]],"b":6,"start":45.116,"end":47.596,"timing":[[0,45.116],[1,45.275],[2,45.47],[3,45.637],[4,46.803],[5,46.942]]},{"k":"e","sec":"examples","en":"Il n'y avait plus de bus, alors j