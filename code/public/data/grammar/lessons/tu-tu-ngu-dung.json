],[5,56.181]]},{"k":"e","sec":"dialogue","en":"Je suis mort de fatigue, maman...","vi":"Con mệt chết đi được, mẹ ơi...","ipa":["ʒə","sɥi","mɔʁ","də","fatiɡ","mamɑ̃"],"who":"paul","ann":{"expression":"sad"},"b":11,"start":57.326,"end":59.216,"timing":[[0,57.326],[1,57.449],[2,57.611],[3,57.798],[4,57.898],[5,58.836]]},{"k":"e","sec":"dialogue","en":"Ah oui ? Mais pour manger du gâteau, tu n'es pas fatigué !","vi":"Thế à? Nhưng ăn bánh thì con chẳng mệt gì nhỉ!","ipa":["a","wi","mɛ","puʁ","mɑ̃ʒe","dy","ɡato","ty","nɛ","pa","fatiɡe"],"who":"maman","ann":{"expression":"happy"},"b":11,"start":60.006,"end":63.566,"timing":[[0,60.006],[1,60.083],[2,61.234],[3,61.446],[4,61.608],[5,61.946],[6,62.071],[7,62.721],[8,62.808],[9,62.958],[10,63.046]]},{"k":"e","sec":"dialogue","en":"D'accord, d'accord, je ne dis pas non. J'arrive !","vi":"Thôi được, được rồi, con không từ chối đâu. Con đến đây!","ipa":["dakɔʁ","dakɔʁ","ʒə","nə","di","pa","nɔ̃","ʒaʁiv"],"who":"paul","ann":{"expression":"happy"},"b":11,"start":64.356,"end":67.926,"timing":[[0,64.356],[1,65.266],[2,66.066],[3,66.166],[4,66.266],[5,66.378],[6,66.503],[7,67.166]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Pháp: Mẹ đã nói với con cả nghìn lần: đóng cửa vào!"}],"b":12,"hold":1,"start":68.916,"end":73.066},{"k":"e","sec":"recall","en":"Je te l'ai dit mille fois : ferme la porte !","vi":"Mẹ đã nói với con cả nghìn lần: đóng cửa vào!","ipa":["ʒə","tə","lɛ","di","mil","fwa","fɛʁm","la","pɔʁt"],"b":13,"start":73.606,"end":75.796,"timing":[[0,73.606],[1,73.746],[2,73.871],[3,73.996],[4,74.158],[5,74.346],[6,74.921],[7,75.221],[8,75.333]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Pháp: Ông hàng xóm già của chúng tôi đã mất mùa đông này."}],"b":14,"hold":1,"start":76.436,"end":80.176},{"k":"e","sec":"recall","en":"Notre vieux voisin nous a quittés cet hiver.","vi":"Ông hàng xóm già của chúng tôi đã mất mùa đông này.","ipa":["nɔtʁ","vjø","vwazɛ̃","nu","a","kite","sɛt","ivɛʁ"],"b":15,"start":80.716,"end"