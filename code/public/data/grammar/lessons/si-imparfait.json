al","parts":[{"v":"Câu cuối là một cách gợi ý thân mật: "},{"e":"si on allait…"},{"v":" mà không cần vế sau."}],"b":11,"start":77.586,"end":82.016},{"k":"n","sec":"mistakes","parts":[{"v":"Sau "},{"e":"si"},{"v":" không bao giờ dùng "},{"e":"conditionnel"},{"v":"."}],"b":12,"start":83.006,"end":86.136},{"k":"e","sec":"mistakes","en":"Si j'avais le temps, je voyagerais.","vi":"Nếu có thời gian, tôi sẽ đi du lịch.","ipa":["si","ʒavɛ","lə","tɑ̃","ʒə","vwajaʒəʁɛ"],"bad":{"en":"Si j'aurais le temps, je voyagerais."},"b":12,"start":86.676,"end":88.616,"timing":[[0,86.676],[1,86.839],[2,87.154],[3,87.299],[4,87.786],[5,87.904]]},{"k":"n","sec":"mistakes","parts":[{"v":"Vế kết quả của "},{"e":"si"},{"v":" cộng "},{"e":"imparfait"},{"v":" phải ở "},{"e":"conditionnel"},{"v":"."}],"b":13,"start":89.256,"end":93.826},{"k":"e","sec":"mistakes","en":"Si j'avais le temps, je voyagerais.","vi":"Nếu có thời gian, tôi sẽ đi du lịch.","ipa":["si","ʒavɛ","lə","tɑ̃","ʒə","vwajaʒəʁɛ"],"bad":{"en":"Si j'avais le temps, je voyagerai."},"b":13,"start":94.366,"end":96.306,"timing":[[0,94.366],[1,94.529],[2,94.844],[3,94.989],[4,95.476],[5,95.594]]},{"k":"n","sec":"mistakes","parts":[{"e":"Si j'étais toi"},{"v":", với "},{"e":"imparfait"},{"v":"."}],"b":14,"start":96.946,"end":99.026},{"k":"e","sec":"mistakes","en":"Si j'étais toi, je partirais.","vi":"Nếu tôi là bạn, tôi sẽ đi.","ipa":["si","ʒetɛ","twa","ʒə","paʁtiʁɛ"],"bad":{"en":"Si je serais toi, je partirais."},"b":14,"start":99.566,"end":101.446,"timing":[[0,99.566],[1,99.719],[2,100.048],[3,100.705],[4,100.824]]},{"k":"n","sec":"pronunciation","parts":[{"v":"Nhớ quy tắc cũ: "},{"e":"si"},{"v":" thành "},{"e":"s'"},{"v":" trước "},{"e":"il"},{"v":" và "},{"e":"ils"},{"v":": "},{"e":"s'il pouvait"},{"v":", "},{"e":"s'ils savaient"},{"v":"."}],"b":15,"start":102.436,"end":108.916,"cues":[[1,107.216]]},{"k":"e","sec":"pronunciation","en":"S'il pouvait, il viendrait.","vi":"Nếu được, anh ấy sẽ đến.","ipa":["sil","puvɛ","il","vjɛ̃dʁɛ"],"b":