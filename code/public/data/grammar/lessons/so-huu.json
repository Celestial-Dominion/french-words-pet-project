{"id":"so-huu","lv":"a1","n":12,"cat":"pronouns","t":"Sở hữu: mon, ma, mes…","en":"mon frère · sa mère · leurs enfants","sum":"Tính từ sở hữu (mon, ma, mes…) hợp với vật được sở hữu, không hợp với người sở hữu. Vì vậy son père là bố của anh ấy hoặc của cô ấy, sa mère là mẹ của anh ấy hoặc của cô ấy. Trước nguyên âm, ma, ta, sa đổi thành mon, ton, son.","forms":[{"f":"mon · ma · mes","vi":"của tôi"},{"f":"ton · ta · tes / son · sa · ses","vi":"của bạn / của anh ấy, cô ấy"},{"f":"notre · nos / votre · vos / leur · leurs","vi":"của chúng tôi / các bạn / họ"}],"pts":[{"id":"possessives","name":"Adjectifs possessifs","vi":"mon, ma, mes · ton… · son… · notre, votre, leur"},{"id":"son-sa-owned","name":"son / sa : genre de l'objet","vi":"son / sa theo giống của VẬT, không theo người sở hữu"}],"cast":{"nam":{"name":{"en":"Nam","vi":"Nam"},"look":"man","style":{"outfit":"shirt","top":"#4F7CC4","topShade":"#3F68A8","accent":"#3F68A8","hair":"fringe","hairColor":"#1F1B1A","skin":"#EFC9A4","skinShade":"#DDB08A"},"x":1040},"maman":{"name":{"en":"Maman","vi":"Mẹ"},"look":"mom","x":560}},"bg":"home-evening","beats":[{"k":"e","sec":"hook","en":"C'est ton frère sur la photo ?","vi":"Người trong ảnh là anh con à?","ipa":["se","tɔ̃","fʁɛʁ","syʁ","la","foto"],"who":"maman","ann":{"expression":"thinking","gesture":"point"},"b":1,"start":0.476,"end":1.916,"timing":[[0,0.476],[1,0.649],[2,0.791],[3,1.174],[4,1.359],[5,1.458]]},{"k":"e","sec":"hook","en":"Oui, c'est mon frère, et ma sœur.","vi":"Vâng, đó là anh con, và chị con.","ipa":["wi","se","mɔ̃","fʁɛʁ","e","ma","sœʁ"],"who":"nam","ann":{"expression":"happy","gesture":"explain"},"b":1,"start":2.706,"end":4.986,"timing":[[0,2.706],[1,3.236],[2,3.407],[3,3.577],[4,4.33],[5,4.387],[6,4.543]]},{"k":"n","sec":"hook","parts":[{"v":"Nam nói "},{"e":"mon frère"},{"v":" nhưng lại nói "},{"e":"ma sœur"},{"v":". Cùng là “của tôi”, sao lại khác?"}],"b":1,"start":5.626,"end":11.436},{"k":"n","sec":"meaning","parts":[{"v":"Tính từ sở hữu đổi theo vậ