{"id":"hop-giong-c1","lv":"c1","n":23,"cat":"adjectives","t":"Hợp giống số tinh tế: toute petite, demi, bleu clair","en":"elle est toute petite · une demi-heure · des yeux bleu clair","sum":"Một số điểm hợp giống số tinh tế. Tout làm trạng từ (nghĩa là rất, hoàn toàn) thường không đổi: ils sont tout contents, elle est tout heureuse; nhưng thành toute, toutes trước tính từ giống cái bắt đầu bằng phụ âm: elle est toute petite. Demi đứng trước danh từ thì không đổi, có gạch nối (une demi-heure); đứng sau thì hợp giống (deux heures et demie). Màu ghép và màu lấy từ danh từ không đổi: des yeux bleu clair, des chaussures marron.","forms":[{"f":"tout + tính từ (trạng từ)","vi":"Ils sont tout contents."},{"f":"toute + tính từ giống cái bắt đầu bằng phụ âm","vi":"Elle est toute rouge."},{"f":"demi trước danh từ: không đổi","vi":"une demi-heure"},{"f":"màu ghép, màu từ danh từ: không đổi","vi":"des yeux bleu clair"}],"pts":[{"id":"agreement-c1","name":"Accords délicats","vi":"Hợp giống số C1: tout trạng từ (rất) không đổi, trừ trước tính từ giống cái bắt đầu bằng phụ âm (tout heureuse, toute petite); demi trước danh từ không đổi (une demi-heure), sau danh từ hợp giống (deux heures et demie); màu ghép và màu từ danh từ không đổi (des yeux bleu clair, des chaussures marron), nhưng rose, mauve vẫn thêm s"}],"cast":{"lea":{"name":{"en":"Léa","vi":"Léa"},"look":"woman","style":{"outfit":"blouse","top":"#D9774F","topShade":"#BF6340","accent":"#C8603B","hair":"long","hairColor":"#6B4226"},"x":560},"zoe":{"name":{"en":"Zoé","vi":"Zoé"},"look":"girl","x":1040}},"bg":"street","beats":[{"k":"e","sec":"hook","en":"Je cherche des chaussures marron et une jupe bleu clair.","vi":"Chị tìm giày màu nâu và một chiếc váy xanh nhạt.","ipa":["ʒə","ʃɛʁʃ","de","ʃosyʁ","maʁɔ̃","e","yn","ʒyp","blø","klɛʁ"],"who":"lea","ann":{"expression":"thinking"},"b":1,"start":0.476,"end":2.636,"timing":[[0,0.476],[1,0.568],[2,0.794],[3,0.906],[4,1.256],[5,1.643],[6,1.719],[7,1.794],[8,2.081],[9,2.231]]},{"k":"e",