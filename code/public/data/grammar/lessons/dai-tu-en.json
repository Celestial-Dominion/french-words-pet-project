{"id":"dai-tu-en","lv":"a2","n":11,"cat":"pronouns","t":"Đại từ en: một ít, mấy cái","en":"j'en veux · il en a deux","sum":"Đại từ en thay cho một danh từ có du, de la, des hoặc de đi trước, nghĩa là “một ít, (một vài) cái đó”. Khi có con số hay từ chỉ lượng, giữ lại con số ở cuối câu: j'en ai deux, il en veut beaucoup. En đứng trước động từ.","forms":[{"f":"en = du / de la / des / de + danh từ","vi":"Tu veux du pain ? — Oui, j'en veux."},{"f":"en + động từ + số / lượng","vi":"J'ai trois frères. → J'en ai trois."},{"f":"ne + en + động từ + pas","vi":"Je n'en veux pas."}],"pts":[{"id":"pronoun-en","name":"Le pronom en","vi":"en = (một ít / số lượng) của nó (thay de + danh từ)"}],"cast":{"papi":{"name":{"en":"Papi","vi":"Ông"},"look":"grandpa","x":560},"lucas":{"name":{"en":"Lucas","vi":"Lucas"},"look":"teenboy","style":{"top":"#F0A43A","topShade":"#D68C27","accent":"#C77E1C","hairColor":"#5A3A22","skin":"#C98E68","skinShade":"#B27852"},"x":1040}},"bg":"kitchen","beats":[{"k":"e","sec":"hook","en":"Tu veux des cerises ?","vi":"Cháu ăn anh đào không?","ipa":["ty","vø","de","səʁiz"],"who":"papi","ann":{"expression":"happy"},"b":1,"start":0.476,"end":1.566,"timing":[[0,0.476],[1,0.574],[2,0.782],[3,0.901]]},{"k":"e","sec":"hook","en":"Oui, j'en veux beaucoup !","vi":"Có ạ, cháu muốn nhiều cơ!","ipa":["wi","ʒɑ̃","vø","boku"],"who":"lucas","ann":{"expression":"happy","gesture":"cheer"},"b":1,"start":2.356,"end":3.646,"timing":[[0,2.356],[1,2.886],[2,3.055],[3,3.212]]},{"k":"n","sec":"hook","parts":[{"e":"J'en veux"},{"v":": "},{"e":"en"},{"v":" thay cho "},{"e":"des cerises"},{"v":". Cậu bé không cần nhắc lại cả cụm."}],"b":1,"start":4.286,"end":9.096},{"k":"n","sec":"meaning","parts":[{"e":"En"},{"v":" thay cho một danh từ mang nghĩa “một ít” hay “một số”: những cụm có "},{"e":"du"},{"v":", "},{"e":"de la"},{"v":", "},{"e":"des"},{"v":"."}],"b":2,"start":10.086,"end":16.146},{"k":"e","sec":"meaning","en":"Tu bois du café ? — Oui, j'en bois.","vi":"Cậu uống cà phê không? —