[{"q":{"fr":"Quand le bébé est-il né ?","vi":"Em bé sinh khi nào?"},"opts":[{"fr":"Le 3 mars","vi":"Ngày 3 tháng Ba"},{"fr":"Le 15 mars","vi":"Ngày 15 tháng Ba"},{"fr":"Le 3 mai","vi":"Ngày 3 tháng Năm"},{"fr":"Le 6 mars","vi":"Ngày 6 tháng Ba"}],"a":0,"why":"Bài đọc: «Il est né le 3 mars, à six heures du matin.»"},{"q":{"fr":"À qui le bébé ressemble-t-il ?","vi":"Em bé giống ai?"},"opts":[{"fr":"À son père","vi":"Giống bố"},{"fr":"À sa mère","vi":"Giống mẹ"},{"fr":"À sa sœur","vi":"Giống chị gái"},{"fr":"À Camille","vi":"Giống Camille"}],"a":0,"why":"Bài đọc: «Tout le monde dit qu'il ressemble à son père !»"},{"q":{"fr":"Pourquoi les parents sont-ils fatigués ?","vi":"Vì sao bố mẹ mệt?"},"opts":[{"fr":"Le bébé pleure la nuit.","vi":"Em bé khóc đêm."},{"fr":"Ils travaillent beaucoup.","vi":"Họ làm việc nhiều."},{"fr":"Emma est malade.","vi":"Emma bị ốm."},{"fr":"Ils ont beaucoup de visites.","vi":"Họ có nhiều khách đến thăm."}],"a":0,"why":"Bài đọc: «Il dort beaucoup, mais la nuit, il pleure souvent.»"},{"q":{"fr":"Quand Camille peut-elle venir ?","vi":"Khi nào Camille có thể đến?"},"opts":[{"fr":"Après le 15 mars","vi":"Sau ngày 15 tháng Ba"},{"fr":"Avant le 3 mars","vi":"Trước ngày 3 tháng Ba"},{"fr":"Demain","vi":"Ngày mai"},{"fr":"En mai","vi":"Vào tháng Năm"}],"a":0,"why":"Bài đọc: «Viens quand tu veux, après le 15 mars.»"}]