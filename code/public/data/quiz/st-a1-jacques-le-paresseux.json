[[{"q":{"fr":"Que fait Jacques toute la journée ?","vi":"Jacques làm gì cả ngày?"},"opts":[{"fr":"Il dort.","vi":"Anh ngủ."},{"fr":"Il travaille.","vi":"Anh làm việc."},{"fr":"Il lit des livres.","vi":"Anh đọc sách."},{"fr":"Il fait la cuisine.","vi":"Anh nấu ăn."}],"a":0,"why":"Trong truyện: «Mais Jacques ne fait rien.»"},{"q":{"fr":"Qu'est-ce que Jacques reçoit lundi ?","vi":"Thứ hai Jacques nhận được gì?"},"opts":[{"fr":"Une pièce d'argent","vi":"Một đồng xu bạc"},{"fr":"Un peu de lait","vi":"Một ít sữa"},{"fr":"Un gros fromage","vi":"Một khoanh pho mát to"},{"fr":"Un petit chat","vi":"Một chú mèo nhỏ"}],"a":0,"why":"Trong truyện: «Le soir, on lui donne une pièce d'argent.»"},{"q":{"fr":"Où Jacques met-il le lait ?","vi":"Jacques để sữa ở đâu?"},"opts":[{"fr":"Dans sa poche","vi":"Trong túi áo"},{"fr":"Sur sa tête","vi":"Trên đầu"},{"fr":"Dans ses mains","vi":"Cầm ở tay"},{"fr":"Dans une boîte","vi":"Trong một cái hộp"}],"a":0,"why":"Trong truyện: «Jacques met le lait dans sa poche !»"}],[{"q":{"fr":"Pourquoi le fromage coule-t-il ?","vi":"Vì sao pho mát chảy ra?"},"opts":[{"fr":"Il fait très chaud.","vi":"Trời rất nóng."},{"fr":"Jacques court vite.","vi":"Jacques chạy nhanh."},{"fr":"Le fromage est vieux.","vi":"Pho mát đã cũ."},{"fr":"Le chat le mange.","vi":"Con mèo ăn nó."}],"a":0,"why":"Trong truyện: «Mais il fait très chaud.»"},{"q":{"fr":"Qu'est-ce que Jacques reçoit jeudi ?","vi":"Thứ năm Jacques nhận được gì?"},"opts":[{"fr":"Un chat","vi":"Một con mèo"},{"fr":"Un chien","vi":"Một con chó"},{"fr":"Du pain","vi":"Bánh mì"},{"fr":"Une pièce","vi":"Một đồng xu"}],"a":0,"why":"Trong truyện: «Le soir, le vieux monsieur lui donne… un chat !»"},{"q":{"fr":"Que fait le chat ?","vi":"Con mèo làm gì?"},"opts":[{"fr":"Il crie et il part.","vi":"Nó kêu lên rồi bỏ chạy."},{"fr":"Il dort dans ses mains.","vi":"Nó ngủ trong tay anh."},{"fr":"Il mange le fromage.","vi":"Nó ăn pho mát."},{"fr":"Il rentre à la maison.","vi":"Nó về nhà."}],"a":0,"why":"Trong truyện: «Il crie et il part en courant.»"}],[{"q":{"fr":"Comment Jacques porte-t-il la viande ?","vi":"Jacques mang thịt về thế nào?"},"opts":[{"fr":"Il la tire derrière lui.","vi":"Anh kéo nó lê phía sau."},{"fr":"Il la porte sur sa tête.","vi":"Anh đội nó trên đầu."},{"fr":"Il la met dans sa poche.","vi":"Anh bỏ nó vào túi."},{"fr":"Il la mange sur la route.","vi":"Anh ăn nó dọc đường."}],"a":0,"why":"Trong truyện: «Il met une corde à la viande et il la tire derrière lui sur la route.»"},{"q":{"fr":"Qu'est-ce que la jeune fille ne fait jamais ?","vi":"Cô gái không bao giờ làm gì?"},"opts":[{"fr":"Elle ne rit jamais.","vi":"Cô không bao giờ cười."},{"fr":"Elle ne mange jamais.","vi":"Cô không bao giờ ăn."},{"fr":"Elle ne sort jamais.","vi":"Cô không bao giờ ra ngoài."},{"fr":"Elle ne parle jamais.","vi":"Cô không bao giờ nói."}],"a":0,"why":"Trong truyện: «Elle ne rit jamais.»"},{"q":{"fr":"Pourquoi la jeune fille rit-elle ?","vi":"Vì sao cô gái cười?"},"opts":[{"fr":"Jacques porte un âne.","vi":"Jacques vác một con lừa."},{"fr":"Jacques danse dans la rue.","vi":"Jacques nhảy múa ngoài đường."},{"fr":"Son père tombe par terre.","vi":"Cha cô ngã xuống đất."},{"fr":"Jacques tombe dans l'eau.","vi":"Jacques ngã xuống nước."}],"a":0,"why":"Trong truyện: «Elle voit Jacques, avec un âne sur ses épaules !»"}]]