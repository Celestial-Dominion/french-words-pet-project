{
  "name": "code",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && eslint --quiet --cache --cache-location node_modules/.cache/eslint/ && vitest run",
    "deploy": "scripts/deploy.sh",
    "content:check": "node --no-warnings scripts/check-content.mjs",
    "content:coverage": "node --no-warnings scripts/content-coverage.mjs",
    "content:kit": "node --no-warnings scripts/content-kit.mjs",
    "content:mt": "node --no-warnings scripts/content-mt.mjs",
    "content:build": "node --no-warnings scripts/build-content.mjs",
    "grammar:check": "node --no-warnings scripts/check-grammar.mjs",
    "grammar:build": "node --no-warnings scripts/build-grammar.mjs && scripts/.venv/bin/python scripts/build-grammar-audio.py && node --no-warnings scripts/build-grammar.mjs --prune",
    "grammar:state": "node --no-warnings scripts/grammar-state.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
