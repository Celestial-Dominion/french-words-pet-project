rules_version = '2';

// App CÁ NHÂN: chỉ tài khoản chủ (UID dưới đây) được đọc/ghi dữ liệu của chính mình.
// Thêm người dùng: sửa danh sách này VÀ NEXT_PUBLIC_OWNER_UID trong .env.local (ngăn cách
// bằng dấu phẩy), rồi deploy lại cả rules lẫn hosting (RULES=1 scripts/deploy.sh).
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedUids() {
      return ["iHstXW8ew7fIHm5nNXQUPBZppSf1"];
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.uid in allowedUids();
    }

    // Doc tiến độ chính: khoá danh sách field + chặn giá trị vô lý. Chủ tài khoản là người
    // dùng tin cậy, nhưng nếu tài khoản Google bị chiếm thì đây là lớp chặn "bơm rác 1MB/doc"
    // làm hỏng vĩnh viễn đồng bộ của chính người đó.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             "daily", "reads", "xp", "notes", "phonics", "grammar",
             "freeze", "reviewChunks", "updatedAt", "config", "configUpdatedAt"
           ])
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.updatedAt is string
        && request.resource.data.reviewChunks is number
        && request.resource.data.reviewChunks <= 100; // ~150k thẻ — xa hơn bộ từ 11k rất nhiều
    }

    // Chunk thẻ ôn: mỗi doc chỉ được có field `items` là mảng (delete để dọn chunk thừa).
    match /users/{uid}/reviews/{chunk} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["items"])
        && request.resource.data.items is list;
    }

    // Mọi thứ khác: cấm.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
